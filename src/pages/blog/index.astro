---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConnectBanner from '../../components/ConnectBanner.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Collect all unique tags
const allTags = Array.from(new Set(publishedPosts.flatMap((p) => p.data.tags)));
---

<BaseLayout
  title="Technical Blog | Javier Carrion (Javi)"
  description="Articles and insights on Angular, TypeScript, Signals, software architecture, technical communication, and developer leadership."
>
  <div class="container page-container">
    <header class="page-header">
      <div class="badge-gold">Writing</div>
      <h1 class="page-title">Technical Articles & Engineering Notes</h1>
      <p class="page-lead">
        Sharing practical patterns, architectural decisions, and lessons learned from building software and organizing developer communities.
      </p>
    </header>

    <!-- Tag Filter Bar -->
    <div class="tags-container" aria-label="Article Topics">
      <span class="tags-heading">Topics:</span>
      <div class="tags-list">
        {allTags.map((tag) => (
          <span class="tag-pill">{tag}</span>
        ))}
      </div>
    </div>

    <!-- Articles Grid -->
    <div class="articles-list">
      {publishedPosts.map((post) => {
        const formattedDate = new Intl.DateTimeFormat('en-US', {
          month: 'short',
          day: 'numeric',
          year: 'numeric',
        }).format(post.data.publishDate);

        return (
          <article class="bento-card blog-index-card interactive">
            <div class="blog-index-thumb-wrapper">
              <img
                src={post.data.coverImage || '/assets/images/laptop-3190194_640.jpg'}
                alt={post.data.coverAlt || post.data.title}
                class="blog-index-thumb"
                loading="lazy"
              />
            </div>
            <div class="blog-index-content">
              <div class="article-meta">
                <span>{formattedDate}</span>
                <span class="meta-dot">·</span>
                <span>{post.data.readingTime}</span>
              </div>

              <h2 class="blog-index-title">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </h2>

              {post.data.subtitle && (
                <p class="blog-index-subtitle">{post.data.subtitle}</p>
              )}

              <p class="blog-index-desc">{post.data.description}</p>

              <div class="blog-index-tags">
                {post.data.tags.map((tag) => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>

              <div class="blog-index-cta">
                <a href={`/blog/${post.slug}/`} class="read-more-link">
                  Read Article <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <ConnectBanner />
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-10);
    padding-bottom: var(--space-16);
  }

  .page-header {
    margin-bottom: var(--space-8);
    max-width: 800px;
  }

  .page-title {
    font-size: var(--fs-3xl);
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .page-lead {
    font-size: var(--fs-md);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
    padding: var(--space-4);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .tags-heading {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--text-tertiary);
    text-transform: uppercase;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .articles-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .blog-index-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding: var(--space-6);
  }

  @media (min-width: 640px) {
    .blog-index-card {
      grid-template-columns: 240px 1fr;
      align-items: center;
    }
  }

  .blog-index-thumb-wrapper {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--bg-surface-elevated);
  }

  .blog-index-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-index-content {
    display: flex;
    flex-direction: column;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-xs);
    color: var(--text-tertiary);
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
  }

  .meta-dot {
    color: var(--text-tertiary);
  }

  .blog-index-title {
    font-size: var(--fs-lg);
    line-height: 1.3;
    margin-bottom: var(--space-1);
  }

  .blog-index-title a {
    color: var(--text-primary);
  }

  .blog-index-title a:hover {
    color: var(--accent-primary-text);
  }

  .blog-index-subtitle {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }

  .blog-index-desc {
    font-size: var(--fs-sm);
    color: var(--text-tertiary);
    line-height: 1.5;
    margin-bottom: var(--space-4);
  }

  .blog-index-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .read-more-link {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--accent-primary-text);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .read-more-link:hover {
    text-decoration: underline;
  }
</style>
