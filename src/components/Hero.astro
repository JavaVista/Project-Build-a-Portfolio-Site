---
// Hero Section with Option A subtle laptop background overlay
---

<section class="hero-section" aria-label="Introduction">
  <div class="hero-bg-overlay" aria-hidden="true"></div>

  <div class="container hero-container">
    <!-- Left Column: Copy & CTAs -->
    <div class="hero-content">
      <div class="badge-gold">
        ¡HOLA! 👋
      </div>

      <h1 class="hero-title">
        I'm Javier Carrion <span class="nickname">(Javi)</span>.
      </h1>

      <h2 class="hero-subtitle">
        Software Engineer specializing in Angular, TypeScript and full-stack web development.
      </h2>

      <p class="hero-desc">
        Building practical software solutions, solving complex technical problems, and sharing what I learn to help other developers grow.
      </p>

      <div class="hero-actions">
        <a href="#featured-projects" class="btn btn-primary">
          <span>💼</span> View My Projects
        </a>
        <a href="/resume/" class="btn btn-secondary">
          <span>📄</span> Download Resume
        </a>
      </div>

      <!-- Social Media Links -->
      <div class="hero-socials" aria-label="Professional Social Links">
        <!-- Bluesky -->
        <a
          href="https://bsky.app/profile/code-vista.bsky.social"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Bluesky Profile"
          class="social-icon-btn"
          title="Bluesky (@code-vista.bsky.social)"
        >
          <svg width="20" height="20" viewBox="0 0 568 501" fill="currentColor">
            <path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-201.21C491.866-1.611 568-28.906 568 57.947c0 17.346-9.945 145.713-15.778 166.555-20.275 72.453-94.155 90.933-159.875 79.748C507.222 323.8 536.444 388.56 473.333 453.32c-119.25 122.39-166.9-30.82-184.889-89.84-4.22-13.85-4.444-14.44-4.444-14.44s-.224.59-4.444 14.44c-17.989 59.02-65.639 212.23-184.889 89.84-63.111-64.76-33.889-129.52 80.986-149.07-65.72 11.185-139.6-7.295-159.875-79.748C9.945 203.659 0 75.293 0 57.946 0-28.906 76.135-1.612 123.121 33.664Z"/>
          </svg>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/technologic"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn Profile"
          class="social-icon-btn"
          title="LinkedIn"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
          </svg>
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/JavaVista"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub Profile"
          class="social-icon-btn"
          title="GitHub"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/>
          </svg>
        </a>

        <!-- YouTube (Personal) -->
        <a
          href="https://www.youtube.com/@JavierCarrion"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube Channel"
          class="social-icon-btn"
          title="YouTube (@JavierCarrion)"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M21.58 7.19a2.5 2.5 0 0 0-1.76-1.77C18.26 5 12 5 12 5s-6.26 0-7.82.42A2.5 2.5 0 0 0 2.42 7.2 26.2 26.2 0 0 0 2 12a26.2 26.2 0 0 0 .42 4.81 2.5 2.5 0 0 0 1.76 1.77C5.74 19 12 19 12 19s6.26 0 7.82-.42a2.5 2.5 0 0 0 1.76-1.77C22 15.22 22 12 22 12s0-3.21-.42-4.81zM9.75 15.02V8.98L15 12l-5.25 3.02z"/>
          </svg>
        </a>

        <!-- Email -->
        <a
          href="mailto:javiercarrionjr@outlook.com"
          aria-label="Email Javier"
          class="social-icon-btn"
          title="Email (javiercarrionjr@outlook.com)"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Right Column: Bento Showcase Card -->
    <div class="hero-card-col">
      <div class="bento-card hero-showcase-card">
        <div class="showcase-header">
          <div class="avatar-ring">
            <img src="/assets/images/Me.png" alt="Javier Carrion" class="hero-avatar" />
          </div>
          <div>
            <h3 class="showcase-name">Javier Carrion</h3>
            <p class="showcase-role">Full-Stack Software Engineer</p>
          </div>
        </div>

        <div class="showcase-divider"></div>

        <div class="skills-section">
          <p class="skills-label">Core Engineering Stack</p>
          <div class="skills-grid">
            <span class="tag-pill">Angular</span>
            <span class="tag-pill">TypeScript</span>
            <span class="tag-pill">JavaScript</span>
            <span class="tag-pill">Vue</span>
            <span class="tag-pill">Node.js</span>
            <span class="tag-pill">Express.js</span>
            <span class="tag-pill">MySQL</span>
            <span class="tag-pill">PostgreSQL</span>
            <span class="tag-pill">REST APIs</span>
            <span class="tag-pill">PSM I Scrum</span>
          </div>
        </div>

        <div class="showcase-footer">
          <div class="status-indicator">
            <span class="status-dot"></span>
            <span>GDG Organizer & Mentor</span>
          </div>
          <span class="experience-badge">25+ Yrs Tech</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    overflow: hidden;
  }

  /* Option A: Laptop background with subtle vignette overlay */
  .hero-bg-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 65%;
    pointer-events: none;
    z-index: 0;
    background-image:
      linear-gradient(to right, var(--bg-primary) 0%, rgba(11, 15, 23, 0.5) 30%, rgba(11, 15, 23, 0.15) 100%),
      linear-gradient(to bottom, var(--bg-primary) 0%, transparent 15%, transparent 85%, var(--bg-primary) 100%),
      url('/assets/images/laptop-3190194_1280.jpg');
    background-repeat: no-repeat;
    background-position: center right;
    background-size: cover;
    opacity: 0.45;
  }

  html[data-theme="light"] .hero-bg-overlay {
    background-image:
      linear-gradient(to right, var(--bg-primary) 0%, rgba(248, 250, 252, 0.6) 35%, rgba(248, 250, 252, 0.2) 100%),
      linear-gradient(to bottom, var(--bg-primary) 0%, transparent 15%, transparent 85%, var(--bg-primary) 100%),
      url('/assets/images/laptop-3190194_1280.jpg');
    opacity: 0.3;
  }

  @media (max-width: 768px) {
    .hero-bg-overlay {
      width: 100%;
      opacity: 0.15;
    }
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 992px) {
    .hero-container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-12);
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-title {
    font-size: var(--fs-hero);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-top: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .nickname {
    color: var(--accent-primary-text);
  }

  .hero-subtitle {
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
    margin-bottom: var(--space-4);
  }

  .hero-desc {
    font-size: var(--fs-md);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    max-width: 600px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .hero-socials {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .social-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .social-icon-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-medium);
    transform: translateY(-2px);
    background-color: var(--bg-surface-elevated);
  }

  /* Right Column Card */
  .hero-card-col {
    width: 100%;
  }

  .hero-showcase-card {
    background-color: rgba(19, 25, 38, 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
  }

  html[data-theme="light"] .hero-showcase-card {
    background-color: rgba(255, 255, 255, 0.82);
    border-color: rgba(226, 232, 240, 0.9);
  }

  .showcase-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .avatar-ring {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--accent-primary);
    flex-shrink: 0;
  }

  .hero-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase-name {
    font-size: var(--fs-md);
    font-weight: 700;
  }

  .showcase-role {
    font-size: var(--fs-xs);
    color: var(--text-tertiary);
  }

  .showcase-divider {
    height: 1px;
    background-color: var(--border-subtle);
    margin: var(--space-4) 0;
  }

  .skills-label {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-3);
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .showcase-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--fs-xs);
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
  }

  .experience-badge {
    font-family: var(--font-mono);
    color: var(--accent-primary-text);
    background-color: var(--accent-primary-subtle);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }
</style>
