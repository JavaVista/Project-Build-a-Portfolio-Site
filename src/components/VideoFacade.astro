---
interface Props {
  youtubeId: string;
  title: string;
  event: string;
  date: string;
  channelName?: string;
  role: string;
}

const { youtubeId, title, event, date, channelName = 'GDG Central Florida', role } = Astro.props;
const thumbnailUrl = `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`;
const videoUrl = `https://www.youtube.com/watch?v=${youtubeId}`;
---

<article class="bento-card video-card interactive">
  <div class="video-thumbnail-container" data-youtube-id={youtubeId}>
    <img src={thumbnailUrl} alt={title} class="video-thumb" loading="lazy" />
    <a
      href={videoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="play-button-overlay"
      aria-label={`Play ${title} on YouTube`}
      data-umami-event="speaking_link_click"
      data-umami-event-title={title}
      data-umami-event-type="youtube_talk"
    >
      <div class="play-icon-badge" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
      </div>
    </a>
  </div>

  <div class="video-content">
    <div class="video-meta">
      <span class="channel-badge">{channelName}</span>
      <span class="meta-dot">·</span>
      <span>{date}</span>
    </div>

    <h3 class="video-title">
      <a
        href={videoUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="speaking_link_click"
        data-umami-event-title={title}
        data-umami-event-type="youtube_talk"
      >
        {title}
        <span class="external-icon" aria-hidden="true">↗</span>
      </a>
    </h3>

    <p class="video-event">{event} · <span class="role-text">{role}</span></p>

    <div class="video-footer">
      <a
        href={videoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="watch-link"
        data-umami-event="speaking_link_click"
        data-umami-event-title={title}
        data-umami-event-type="youtube_talk"
      >
        Watch on YouTube <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</article>

<style>
  .video-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    height: 100%;
  }

  .video-thumbnail-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #000000;
    overflow: hidden;
  }

  .video-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .video-card:hover .video-thumb {
    transform: scale(1.03);
  }

  .play-button-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.25);
    transition: background var(--transition-fast);
  }

  .video-card:hover .play-button-overlay {
    background: rgba(0, 0, 0, 0.1);
  }

  .play-icon-badge {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: rgba(239, 68, 68, 0.95);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 3px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    transition: transform var(--transition-fast);
  }

  .play-button-overlay:hover .play-icon-badge {
    transform: scale(1.1);
    background-color: #dc2626;
  }

  .video-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-5);
  }

  .video-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-xs);
    color: var(--text-tertiary);
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
  }

  .channel-badge {
    color: var(--accent-primary-text);
  }

  .meta-dot {
    color: var(--text-tertiary);
  }

  .video-title {
    font-size: var(--fs-md);
    margin-bottom: var(--space-2);
  }

  .video-title a {
    color: var(--text-primary);
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }

  .video-title a:hover {
    color: var(--accent-primary-text);
  }

  .external-icon {
    font-size: 0.85em;
    color: var(--text-tertiary);
  }

  .video-event {
    font-size: var(--fs-xs);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  .role-text {
    color: var(--text-tertiary);
  }

  .video-footer {
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }

  .watch-link {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--accent-primary-text);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .watch-link:hover {
    text-decoration: underline;
  }
</style>
