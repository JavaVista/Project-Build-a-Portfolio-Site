---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConnectBanner from '../../components/ConnectBanner.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Core pillar taxonomy in priority order
const PRIORITY_TAGS = [
  'Developer Community',
  'AI Agents',
  'Google Cloud',
  'Angular',
  'Technical Communication',
  'DevFest Florida',
  'Hackathons',
  'Software Engineering',
];

// Compute post frequency per tag
const tagCounts = new Map<string, number>();
for (const post of publishedPosts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
}

// Rank tags: core pillars first (in defined priority order), then remaining tags sorted by frequency & alphabetically
const allTags = Array.from(tagCounts.keys()).sort((a, b) => {
  const indexA = PRIORITY_TAGS.indexOf(a);
  const indexB = PRIORITY_TAGS.indexOf(b);

  if (indexA !== -1 && indexB !== -1) return indexA - indexB;
  if (indexA !== -1) return -1;
  if (indexB !== -1) return 1;

  const countDiff = (tagCounts.get(b) || 0) - (tagCounts.get(a) || 0);
  return countDiff !== 0 ? countDiff : a.localeCompare(b);
});

const INITIAL_VISIBLE_COUNT = 8;
const visibleTags = allTags.slice(0, INITIAL_VISIBLE_COUNT);
const extraTags = allTags.slice(INITIAL_VISIBLE_COUNT);
---

<BaseLayout
  title="Technical Blog | Javier Carrion (Javi)"
  description="Articles and insights on Angular, TypeScript, AI Agents, Google Cloud, software architecture, technical communication, and developer community leadership."
>
  <div class="container page-container">
    <header class="page-header">
      <div class="badge-gold">Writing</div>
      <h1 class="page-title">Technical Articles & Engineering Notes</h1>
      <p class="page-lead">
        Sharing practical patterns, architectural decisions, and lessons learned from building software and organizing developer communities.
      </p>
    </header>

    <!-- Accessible Topic Filter Bar -->
    <nav class="tags-container" aria-label="Filter articles by topic">
      <span class="tags-heading" id="topics-filter-label">Topics:</span>
      <div class="tags-list" id="blog-topics-list">
        <button
          type="button"
          class="tag-pill tag-filter-btn is-active"
          data-topic-filter="all"
          aria-pressed="true"
        >
          <span>All</span>
          <span class="tag-count" aria-label={`${publishedPosts.length} articles`}>{publishedPosts.length}</span>
        </button>

        {visibleTags.map((tag) => (
          <button
            type="button"
            class="tag-pill tag-filter-btn"
            data-topic-filter={tag}
            aria-pressed="false"
          >
            <span>{tag}</span>
          </button>
        ))}

        {extraTags.length > 0 && (
          <div id="extra-topics-group" class="extra-topics-group" data-collapsed="true">
            {extraTags.map((tag) => (
              <button
                type="button"
                class="tag-pill tag-filter-btn"
                data-topic-filter={tag}
                aria-pressed="false"
              >
                <span>{tag}</span>
              </button>
            ))}
          </div>
        )}

        {extraTags.length > 0 && (
          <button
            type="button"
            id="topics-toggle-btn"
            class="tag-pill tag-toggle-btn"
            aria-expanded="false"
            aria-controls="extra-topics-group"
            data-extra-count={extraTags.length}
          >
            +{extraTags.length} more
          </button>
        )}
      </div>
    </nav>

    <!-- Live Filter Status for Screen Readers & Visual Feedback -->
    <p id="filter-status" class="filter-status" aria-live="polite" hidden></p>

    <!-- Articles Grid -->
    <div class="articles-list" id="articles-list">
      {publishedPosts.map((post, index) => {
        const formattedDate = new Intl.DateTimeFormat('en-US', {
          month: 'short',
          day: 'numeric',
          year: 'numeric',
          timeZone: 'UTC',
        }).format(post.data.publishDate);

        return (
          <article
            class="bento-card blog-index-card interactive"
            data-article-tags={JSON.stringify(post.data.tags)}
          >
            <div class="blog-index-thumb-wrapper">
              <img
                src={post.data.coverImage || '/assets/images/laptop-3190194_640.webp'}
                alt={post.data.coverAlt || post.data.title}
                class="blog-index-thumb"
                width="480"
                height="270"
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : undefined}
                decoding={index === 0 ? 'sync' : 'async'}
              />
            </div>
            <div class="blog-index-content">
              <div class="article-meta">
                <span>{formattedDate}</span>
                <span class="meta-dot">·</span>
                <span>{post.data.readingTime}</span>
              </div>

              <h2 class="blog-index-title">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </h2>

              {post.data.subtitle && (
                <p class="blog-index-subtitle">{post.data.subtitle}</p>
              )}

              <p class="blog-index-desc">{post.data.description}</p>

              <div class="blog-index-tags">
                {post.data.tags.map((tag) => (
                  <button
                    type="button"
                    class="tag-pill card-tag-btn"
                    data-card-topic={tag}
                    aria-label={`Filter articles by ${tag}`}
                  >
                    {tag}
                  </button>
                ))}
              </div>

              <div class="blog-index-cta">
                <a href={`/blog/${post.slug}/`} class="read-more-link">
                  Read Article <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <ConnectBanner />
  </div>
</BaseLayout>

<script is:inline>
  (function() {
    function initBlogTopicFilter() {
      const nav = document.querySelector('.tags-container');
      if (!nav || nav.hasAttribute('data-filter-bound')) return;
      nav.setAttribute('data-filter-bound', 'true');

      const filterButtons = Array.from(document.querySelectorAll('[data-topic-filter]'));
      const cardTagButtons = Array.from(document.querySelectorAll('[data-card-topic]'));
      const articles = Array.from(document.querySelectorAll('[data-article-tags]'));
      const toggleBtn = document.getElementById('topics-toggle-btn');
      const extraGroup = document.getElementById('extra-topics-group');
      const filterStatus = document.getElementById('filter-status');

      if (!filterButtons.length || !articles.length) return;

      function setExpandedState(expanded) {
        if (!toggleBtn || !extraGroup) return;
        const extraCount = toggleBtn.getAttribute('data-extra-count') || '';
        toggleBtn.setAttribute('aria-expanded', String(expanded));
        if (expanded) {
          extraGroup.removeAttribute('data-collapsed');
          toggleBtn.textContent = 'Show less';
        } else {
          extraGroup.setAttribute('data-collapsed', 'true');
          toggleBtn.textContent = '+' + extraCount + ' more';
        }
      }

      function applyTopicFilter(selectedTopic, updateUrl) {
        if (updateUrl === undefined) updateUrl = true;
        const normalizedTopic = selectedTopic || 'all';

        // If the selected topic lives inside the collapsed overflow group, expand it automatically
        if (
          normalizedTopic !== 'all' &&
          extraGroup &&
          extraGroup.hasAttribute('data-collapsed')
        ) {
          const isInExtra = Array.from(
            extraGroup.querySelectorAll('[data-topic-filter]')
          ).some(function(btn) {
            return btn.getAttribute('data-topic-filter') === normalizedTopic;
          });
          if (isInExtra) {
            setExpandedState(true);
          }
        }

        // Update ARIA pressed states & active classes on filter bar buttons
        filterButtons.forEach(function(btn) {
          const isMatch = btn.getAttribute('data-topic-filter') === normalizedTopic;
          btn.setAttribute('aria-pressed', String(isMatch));
          btn.classList.toggle('is-active', isMatch);
        });

        // Highlight matching tag pills inside article cards
        cardTagButtons.forEach(function(btn) {
          const isMatch =
            normalizedTopic !== 'all' &&
            btn.getAttribute('data-card-topic') === normalizedTopic;
          btn.classList.toggle('is-active', isMatch);
        });

        // Filter articles
        let visibleCount = 0;
        articles.forEach(function(article) {
          const rawTags = article.getAttribute('data-article-tags');
          let tags = [];
          try {
            tags = rawTags ? JSON.parse(rawTags) : [];
          } catch (_) {
            tags = [];
          }

          const shouldShow = normalizedTopic === 'all' || tags.indexOf(normalizedTopic) !== -1;
          article.hidden = !shouldShow;
          if (shouldShow) visibleCount++;
        });

        // Update polite live region & status message
        if (filterStatus) {
          if (normalizedTopic === 'all') {
            filterStatus.hidden = true;
            filterStatus.textContent = '';
          } else {
            filterStatus.hidden = false;
            filterStatus.textContent =
              'Showing ' +
              visibleCount +
              ' ' +
              (visibleCount === 1 ? 'article' : 'articles') +
              ' tagged "' +
              normalizedTopic +
              '".';
          }
        }

        // Sync URL query parameter for shareable deep links
        if (updateUrl) {
          const url = new URL(window.location.href);
          if (normalizedTopic === 'all') {
            url.searchParams.delete('topic');
          } else {
            url.searchParams.set('topic', normalizedTopic);
          }
          window.history.replaceState({}, '', url);
        }
      }

      // Filter button clicks
      filterButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          const topic = btn.getAttribute('data-topic-filter') || 'all';
          const isCurrentlyActive = btn.getAttribute('aria-pressed') === 'true';
          const nextTopic = isCurrentlyActive && topic !== 'all' ? 'all' : topic;
          applyTopicFilter(nextTopic, true);
        });
      });

      // Clicking a tag pill on an article card filters by that topic
      cardTagButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          const topic = btn.getAttribute('data-card-topic') || 'all';
          applyTopicFilter(topic, true);
        });
      });

      // Progressive disclosure toggle (+X more / Show less)
      if (toggleBtn && extraGroup) {
        toggleBtn.addEventListener('click', function() {
          const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
          setExpandedState(!isExpanded);
        });
      }

      // Initialize from ?topic= URL query parameter if present
      const params = new URLSearchParams(window.location.search);
      const initialTopic = params.get('topic');
      if (initialTopic) {
        const exists = filterButtons.some(function(btn) {
          return btn.getAttribute('data-topic-filter') === initialTopic;
        });
        if (exists) {
          applyTopicFilter(initialTopic, false);
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBlogTopicFilter);
    } else {
      initBlogTopicFilter();
    }
    document.addEventListener('astro:after-swap', initBlogTopicFilter);
    document.addEventListener('astro:page-load', initBlogTopicFilter);
  })();
</script>

<style>
  .page-container {
    padding-top: var(--space-10);
    padding-bottom: var(--space-16);
  }

  .page-header {
    margin-bottom: var(--space-8);
    max-width: 800px;
  }

  .page-title {
    font-size: var(--fs-3xl);
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .page-lead {
    font-size: var(--fs-md);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding: var(--space-4);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .tags-heading {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    flex: 1;
  }

  /* Keep extra topics in the DOM for SEO crawlers; toggle visibility cleanly */
  .extra-topics-group {
    display: contents;
  }

  .extra-topics-group[data-collapsed="true"] {
    display: none;
  }

  /* Interactive Topic Filter Buttons & Touch Target Compliance (WCAG AA) */
  .tag-filter-btn,
  .tag-toggle-btn,
  .card-tag-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-block-size: 36px;
    padding: 6px 14px;
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    font-weight: 500;
    line-height: 1.2;
    color: var(--text-secondary);
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-full);
    cursor: pointer;
    user-select: none;
    transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  /* Expand tap target to >= 44x44px on touch / coarse-pointer devices */
  @media (pointer: coarse) {
    .tag-filter-btn,
    .tag-toggle-btn,
    .card-tag-btn {
      min-block-size: 44px;
      min-inline-size: 44px;
      padding: 8px 16px;
    }

    .tags-list,
    .blog-index-tags {
      gap: 10px;
    }
  }

  .tag-filter-btn:hover,
  .card-tag-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-highlight);
    background-color: var(--accent-primary-subtle);
  }

  .tag-filter-btn:active,
  .tag-toggle-btn:active,
  .card-tag-btn:active {
    transform: scale(0.97);
  }

  .tag-filter-btn.is-active,
  .tag-filter-btn[aria-pressed="true"],
  .card-tag-btn.is-active {
    background-color: var(--accent-primary);
    color: #ffffff;
    border-color: var(--accent-primary);
    font-weight: 600;
    box-shadow: var(--shadow-sm);
  }

  .tag-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1px 6px;
    font-size: 0.7rem;
    border-radius: var(--radius-full);
    background-color: rgba(255, 255, 255, 0.2);
    color: inherit;
  }

  .tag-filter-btn:not(.is-active) .tag-count {
    background-color: var(--bg-surface);
    color: var(--text-secondary);
  }

  /* Distinct "+X more" / "Show less" Disclosure Toggle Button (4.5:1+ contrast in light & dark mode) */
  .tag-toggle-btn {
    color: var(--accent-primary-text);
    background-color: transparent;
    border: 1px dashed var(--border-highlight);
    font-weight: 600;
  }

  .tag-toggle-btn:hover {
    background-color: var(--accent-primary-subtle);
    border-style: solid;
    border-color: var(--accent-primary-text);
  }

  .tag-filter-btn:focus-visible,
  .tag-toggle-btn:focus-visible,
  .card-tag-btn:focus-visible {
    outline: 2px solid var(--accent-primary-text);
    outline-offset: 3px;
  }

  .filter-status {
    font-size: var(--fs-sm);
    font-family: var(--font-mono);
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  .articles-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .blog-index-card[hidden] {
    display: none;
  }

  .blog-index-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding: var(--space-6);
  }

  @media (min-width: 640px) {
    .blog-index-card {
      grid-template-columns: 240px 1fr;
      align-items: center;
    }
  }

  .blog-index-thumb-wrapper {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--bg-surface-elevated);
  }

  .blog-index-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-index-content {
    display: flex;
    flex-direction: column;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-xs);
    color: var(--text-tertiary);
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
  }

  .meta-dot {
    color: var(--text-tertiary);
  }

  .blog-index-title {
    font-size: var(--fs-lg);
    line-height: 1.3;
    margin-bottom: var(--space-1);
  }

  .blog-index-title a {
    color: var(--text-primary);
  }

  .blog-index-title a:hover {
    color: var(--accent-primary-text);
  }

  .blog-index-subtitle {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }

  .blog-index-desc {
    font-size: var(--fs-sm);
    color: var(--text-tertiary);
    line-height: 1.5;
    margin-bottom: var(--space-4);
  }

  .blog-index-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .read-more-link {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--accent-primary-text);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .read-more-link:hover {
    text-decoration: underline;
  }
</style>
