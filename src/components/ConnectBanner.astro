---
// "Let's Connect" callout banner from the wireframe
---

<section class="connect-section" aria-label="Contact Callout">
  <div class="bento-card connect-card">
    <div class="connect-icon-circle" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="22" y1="2" x2="11" y2="13"></line>
        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
      </svg>
    </div>

    <div class="connect-body">
      <h3 class="connect-title">Let's Connect</h3>
      <p class="connect-desc">
        Feel free to reach out for opportunities, collaborations, or just to say hello.
      </p>
    </div>

    <div class="connect-action">
      <a 
        href="#" 
        data-email-u="amF2aWVyY2Fycmlvbmpy" 
        data-email-d="b3V0bG9vay5jb20=" 
        class="btn btn-primary connect-btn"
        aria-label="Send email to Javier"
        data-umami-event="contact_click"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span>Get in Touch</span>
      </a>
    </div>
  </div>
</section>

<style>
  .connect-section {
    margin-top: var(--space-12);
    margin-bottom: var(--space-16);
  }

  .connect-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-8);
    background: linear-gradient(135deg, rgba(19, 25, 38, 0.95) 0%, rgba(30, 58, 138, 0.25) 100%);
    border-color: rgba(59, 130, 246, 0.3);
  }

  html[data-theme="light"] .connect-card {
    background: linear-gradient(135deg, #ffffff 0%, rgba(219, 234, 254, 0.5) 100%);
    border-color: #bfdbfe;
  }

  @media (min-width: 768px) {
    .connect-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
    }
  }

  .connect-icon-circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background-color: var(--accent-primary-subtle);
    border: 1px solid var(--border-highlight);
    color: var(--accent-primary-text);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .connect-body {
    flex-grow: 1;
  }

  .connect-title {
    font-size: var(--fs-lg);
    margin-bottom: var(--space-1);
  }

  .connect-desc {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
  }

  .connect-action {
    flex-shrink: 0;
  }

  .connect-btn {
    padding: 0.8rem 1.6rem;
  }
</style>
