---
interface Props {
  title: string;
  description: string;
  href: string;
  ctaText: string;
  icon: 'user' | 'users' | 'document';
}

const { title, description, href, ctaText, icon } = Astro.props;
---

<a href={href} class="bento-card nav-bento-card interactive">
  <div class="nav-icon-circle" aria-hidden="true">
    {icon === 'user' && (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
    )}
    {icon === 'users' && (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
    )}
    {icon === 'document' && (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
    )}
  </div>

  <div class="nav-card-body">
    <h3 class="nav-card-title">{title}</h3>
    <p class="nav-card-desc">{description}</p>
    <span class="nav-card-link">
      {ctaText} <span aria-hidden="true">&rarr;</span>
    </span>
  </div>
</a>

<style>
  .nav-bento-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-decoration: none;
    height: 100%;
  }

  .nav-icon-circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-primary-text);
    flex-shrink: 0;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .nav-bento-card:hover .nav-icon-circle {
    transform: scale(1.08);
    border-color: var(--accent-primary);
  }

  .nav-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex-grow: 1;
  }

  .nav-card-title {
    font-size: var(--fs-md);
    color: var(--text-primary);
  }

  .nav-card-desc {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    line-height: 1.5;
    flex-grow: 1;
  }

  .nav-card-link {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--accent-primary-text);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: var(--space-2);
  }

  .nav-bento-card:hover .nav-card-link {
    text-decoration: underline;
  }
</style>
