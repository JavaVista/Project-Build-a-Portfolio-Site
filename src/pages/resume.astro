---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConnectBanner from '../components/ConnectBanner.astro';
---

<BaseLayout
  title="Resume & Experience | Javier Carrion (Javi)"
  description="Professional software engineering resume of Javier Carrion. Bilingual software engineer with 6+ years professional web development, 25+ years in technology, Angular, TypeScript, Node.js, and PSM I certified."
>
  <div class="container page-container">
    <header class="resume-header">
      <div class="header-text">
        <div class="badge-gold">Professional Experience</div>
        <h1 class="resume-title">Javier Carrion</h1>
        <p class="resume-subtitle">
          Software Engineer | Angular · TypeScript · Full-Stack Web Development · Quality Engineering
        </p>
        <p class="resume-meta">
          📍 Ocala, Florida · <a href="#" data-email-u="amF2aWVyY2Fycmlvbmpy" data-email-d="b3V0bG9vay5jb20=" class="resume-email-link" data-umami-event="contact_click">Contact via Email</a> · <a href="https://www.linkedin.com/in/technologic" target="_blank" rel="noopener noreferrer" data-umami-event="linkedin_profile_click">linkedin.com/in/technologic</a> · <a href="https://techno-logic.us">techno-logic.us</a>
        </p>
      </div>

      <div class="resume-actions">
        <button type="button" class="btn btn-secondary print-btn" onclick="window.print()" title="Print or save as PDF">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect width="12" height="8" x="6" y="14"></rect>
          </svg>
          <span>Print</span>
        </button>
        <a href="/resume.pdf" class="btn btn-primary download-btn" download="Javier_Carrion_Resume.pdf" data-umami-event="resume_download">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download PDF</span>
        </a>
      </div>
    </header>

    <!-- Professional Summary -->
    <section class="resume-section">
      <h2 class="section-heading">Professional Summary</h2>
      <div class="bento-card resume-card">
        <p>
          Bilingual software engineer (English & Spanish) with 6+ years of professional web application development experience and 25+ years across technology, quality assurance, and systems development. Builds and maintains enterprise applications using Angular, TypeScript, Vue, Node.js, Express.js, MySQL, and PostgreSQL. Brings a strong testing mindset, deep experience delivering reliable changes through QA to production, and a proven track record of mentorship, technical communication, and cross-functional team leadership.
        </p>
      </div>
    </section>

    <!-- Technical Skills Matrix -->
    <section class="resume-section">
      <h2 class="section-heading">Technical Skills</h2>
      <div class="bento-card skills-card">
        <div class="skill-category">
          <span class="skill-category-title">Frontend:</span>
          <div class="skill-tags">
            <span class="tag-pill">Angular</span>
            <span class="tag-pill">TypeScript</span>
            <span class="tag-pill">JavaScript (ES6+)</span>
            <span class="tag-pill">Vue</span>
            <span class="tag-pill">HTML5</span>
            <span class="tag-pill">CSS/Sass</span>
            <span class="tag-pill">Tailwind</span>
            <span class="tag-pill">Ionic</span>
            <span class="tag-pill">Stencil.js</span>
            <span class="tag-pill">Web Components</span>
          </div>
        </div>

        <div class="skill-category">
          <span class="skill-category-title">Backend & Data:</span>
          <div class="skill-tags">
            <span class="tag-pill">Node.js</span>
            <span class="tag-pill">Express.js</span>
            <span class="tag-pill">REST APIs</span>
            <span class="tag-pill">MySQL</span>
            <span class="tag-pill">PostgreSQL</span>
            <span class="tag-pill">Database Migrations</span>
            <span class="tag-pill">Python</span>
          </div>
        </div>

        <div class="skill-category">
          <span class="skill-category-title">Engineering & QA:</span>
          <div class="skill-tags">
            <span class="tag-pill">Git / GitHub</span>
            <span class="tag-pill">Azure DevOps</span>
            <span class="tag-pill">Agile / Scrum</span>
            <span class="tag-pill">Regression Testing</span>
            <span class="tag-pill">Test Planning</span>
            <span class="tag-pill">Unit Testing</span>
            <span class="tag-pill">CI/CD Workflows</span>
          </div>
        </div>

        <div class="skill-category">
          <span class="skill-category-title">Languages:</span>
          <div class="skill-tags">
            <span class="tag-pill">English (Fluent)</span>
            <span class="tag-pill">Spanish (Bilingual / Fluent)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Professional Experience -->
    <section class="resume-section">
      <h2 class="section-heading">Professional Experience</h2>
      <div class="experience-timeline">
        <!-- Role 1 -->
        <article class="bento-card timeline-card">
          <div class="timeline-header">
            <div>
              <h3 class="role-title">Software Engineer II (Web)</h3>
              <p class="company-name">Design Interactive, LLC</p>
            </div>
            <span class="role-dates">Sep 2022 – Present</span>
          </div>
          <ul class="role-bullets">
            <li>Develop and maintain web applications supporting complex training, assessment, and human-system integration workflows across multidisciplinary engineering, UX, and QA teams.</li>
            <li>Contributed full-stack improvements on IMITATE and EXTRACT applications, resolving REST API endpoints with Node.js and Express.js, and executing MySQL database migrations with zero production regressions.</li>
            <li>Supported major Angular application modernization, including framework upgrades to modern Angular and validation of dependency and UI behavioral changes.</li>
            <li>Built ClassroomXR V2 web features for XRMentor, including participant views, organizer controls, session timers, and real-time screen-sharing interfaces.</li>
            <li>Contributed to Vue-based micro-frontend architecture, code reviews, testing, and delivery coordination across program increment events.</li>
            <li>Regularly mentor junior engineers through structured check-ins on clean code, Git practices, CSS, and software design principles.</li>
          </ul>
        </article>

        <!-- Role 2 -->
        <article class="bento-card timeline-card">
          <div class="timeline-header">
            <div>
              <h3 class="role-title">Software Systems Engineer I (Web)</h3>
              <p class="company-name">Design Interactive, LLC</p>
            </div>
            <span class="role-dates">May 2020 – Sep 2022</span>
          </div>
          <ul class="role-bullets">
            <li>Developed responsive frontend software using Angular, TypeScript, HTML, Sass, and Foundation frameworks.</li>
            <li>Collaborated with research scientists and designers to translate experimental specifications into intuitive software features.</li>
            <li>Executed cross-browser debugging, bug verification, and iterative enhancements across rapid Agile delivery cycles.</li>
          </ul>
        </article>

        <!-- Role 3 -->
        <article class="bento-card timeline-card">
          <div class="timeline-header">
            <div>
              <h3 class="role-title">Quality Assurance Analyst</h3>
              <p class="company-name">equivant</p>
            </div>
            <span class="role-dates">Nov 2017 – May 2020</span>
          </div>
          <ul class="role-bullets">
            <li>Tested complex court case-management enterprise software, including GUI behavior, functional data workflows, and critical regression scenarios.</li>
            <li>Collaborated directly with software engineers on edge-case testing, defect triage, and verified customer release notes.</li>
          </ul>
        </article>

        <!-- Role 4 -->
        <article class="bento-card timeline-card">
          <div class="timeline-header">
            <div>
              <h3 class="role-title">Mobile Application Developer</h3>
              <p class="company-name">CherriPick (Project Engagement)</p>
            </div>
            <span class="role-dates">Jul 2019 – Dec 2019</span>
          </div>
          <ul class="role-bullets">
            <li>Built cross-platform mobile features using React Native, implementing camera access, voice recording, date-picker functionality, and defect resolution.</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Education & Certifications -->
    <section class="resume-section">
      <h2 class="section-heading">Education & Certifications</h2>
      <div class="grid-3">
        <div class="bento-card edu-card">
          <div class="edu-icon" aria-hidden="true">📜</div>
          <h3 class="edu-title">Professional Scrum Master I (PSM I)</h3>
          <p class="edu-org">Scrum.org</p>
          <p class="edu-desc">Comprehensive certification in Scrum framework, accountabilities, and empirical process control.</p>
        </div>

        <div class="bento-card edu-card">
          <div class="edu-icon" aria-hidden="true">🎓</div>
          <h3 class="edu-title">Front-End Web Developer Nanodegree</h3>
          <p class="edu-org">Udacity (2019)</p>
          <p class="edu-desc">Rigorous program in modern JavaScript, responsive design, performance optimization, and Service Workers.</p>
        </div>

        <div class="bento-card edu-card">
          <div class="edu-icon" aria-hidden="true">💻</div>
          <h3 class="edu-title">Intro to Programming Nanodegree</h3>
          <p class="edu-org">Udacity (2016)</p>
          <p class="edu-desc">Foundational software engineering in Python, HTML, CSS, and algorithmic thinking.</p>
        </div>
      </div>
    </section>

    <ConnectBanner />
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-10);
    padding-bottom: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .resume-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    justify-content: space-between;
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 768px) {
    .resume-header {
      flex-direction: row;
      align-items: center;
    }
  }

  .resume-title {
    font-size: var(--fs-3xl);
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .resume-subtitle {
    font-size: var(--fs-md);
    color: var(--accent-primary-text);
    font-weight: 500;
    margin-bottom: var(--space-2);
  }

  .resume-meta {
    font-size: var(--fs-xs);
    color: var(--text-tertiary);
  }

  .resume-meta a {
    color: var(--text-secondary);
  }

  .resume-meta a:hover {
    color: var(--accent-primary-text);
    text-decoration: underline;
  }

  .print-btn,
  .download-btn {
    padding: 0.75rem 1.4rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1;
  }

  .resume-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .section-heading {
    font-size: var(--fs-xl);
    border-bottom: 2px solid var(--border-subtle);
    padding-bottom: var(--space-2);
  }

  .resume-card p {
    font-size: var(--fs-base);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  /* Skills Matrix */
  .skills-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .skill-category {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  @media (min-width: 640px) {
    .skill-category {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-4);
    }
  }

  .skill-category-title {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--text-primary);
    min-width: 130px;
    flex-shrink: 0;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Timeline */
  .experience-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .timeline-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .timeline-header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-1);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-3);
  }

  @media (min-width: 640px) {
    .timeline-header {
      flex-direction: row;
      align-items: baseline;
    }
  }

  .role-title {
    font-size: var(--fs-md);
  }

  .company-name {
    font-size: var(--fs-sm);
    color: var(--accent-primary-text);
    font-weight: 500;
  }

  .role-dates {
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    color: var(--text-tertiary);
  }

  .role-bullets {
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .role-bullets li {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Education Cards */
  .edu-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .edu-icon {
    font-size: 1.8rem;
    margin-bottom: var(--space-2);
  }

  .edu-title {
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .edu-org {
    font-size: var(--fs-xs);
    color: var(--accent-primary-text);
  }

  .edu-desc {
    font-size: var(--fs-xs);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .resume-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .print-btn,
  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
  }

  /* ============================================================
     Print Stylesheet for Browser "Print / Save as PDF"
     ============================================================ */
  @media print {
    /* Hide site chrome, navigation, actions, and decorative elements */
    :global(header.site-header),
    :global(footer.site-footer),
    :global(#email-toast),
    :global(.skip-to-content),
    .resume-actions,
    .badge-gold,
    :global(.connect-section) {
      display: none !important;
    }

    /* Reset background and layout for clean white paper */
    :global(body),
    :global(html) {
      background: #ffffff !important;
      color: #0f172a !important;
      font-size: 10.5pt !important;
    }

    .page-container {
      padding: 0 !important;
      max-width: 100% !important;
      gap: 14pt !important;
    }

    .resume-header {
      padding-bottom: 10pt !important;
      border-bottom: 2pt solid #0f172a !important;
      margin-bottom: 2pt !important;
    }

    .resume-title {
      font-size: 20pt !important;
      color: #0f172a !important;
      margin: 0 0 3pt 0 !important;
    }

    .resume-subtitle {
      font-size: 11pt !important;
      color: #1e293b !important;
      font-weight: 600 !important;
      margin-bottom: 4pt !important;
    }

    .resume-meta {
      font-size: 9pt !important;
      color: #475569 !important;
    }

    .resume-meta a {
      color: #0f172a !important;
      text-decoration: none !important;
    }

    .section-heading {
      font-size: 12pt !important;
      color: #0f172a !important;
      font-weight: 700 !important;
      border-bottom: 1.5pt solid #cbd5e1 !important;
      padding-bottom: 3pt !important;
      margin-top: 4pt !important;
      margin-bottom: 6pt !important;
      page-break-after: avoid;
      break-after: avoid;
    }

    /* Cards become clean, borderless containers on paper */
    .bento-card {
      background: #ffffff !important;
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
    }

    .resume-card p {
      color: #334155 !important;
      font-size: 9.5pt !important;
      line-height: 1.5 !important;
    }

    /* Skills Matrix */
    .skills-card {
      gap: 6pt !important;
    }

    .skill-category-title {
      font-size: 9.5pt !important;
      font-weight: 700 !important;
      color: #0f172a !important;
    }

    .tag-pill {
      font-size: 8.5pt !important;
      padding: 1.5pt 5pt !important;
      background: #f1f5f9 !important;
      color: #0f172a !important;
      border: 1px solid #cbd5e1 !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    /* Experience Timeline */
    .experience-timeline {
      gap: 10pt !important;
    }

    .timeline-card {
      page-break-inside: avoid;
      break-inside: avoid;
      padding-bottom: 8pt !important;
      border-bottom: 1px solid #e2e8f0 !important;
      margin-bottom: 6pt !important;
    }

    .role-title {
      font-size: 10.5pt !important;
      font-weight: 700 !important;
      color: #0f172a !important;
    }

    .company-name {
      font-size: 9.5pt !important;
      color: #334155 !important;
      font-weight: 600 !important;
    }

    .role-dates {
      font-size: 8.5pt !important;
      color: #64748b !important;
    }

    .role-bullets {
      padding-left: 12pt !important;
      margin-top: 3pt !important;
      gap: 2pt !important;
    }

    .role-bullets li {
      font-size: 9pt !important;
      color: #334155 !important;
      line-height: 1.4 !important;
    }

    /* Education & Certifications */
    .edu-grid {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 8pt !important;
    }

    .edu-card {
      page-break-inside: avoid;
      break-inside: avoid;
      border: 1px solid #e2e8f0 !important;
      padding: 6pt !important;
      border-radius: 4pt !important;
    }

    .edu-icon {
      display: none !important;
    }

    .edu-title {
      font-size: 9.5pt !important;
      color: #0f172a !important;
    }

    .edu-org {
      font-size: 8.5pt !important;
      color: #475569 !important;
    }

    .edu-desc {
      font-size: 8pt !important;
      color: #64748b !important;
    }
  }
</style>
