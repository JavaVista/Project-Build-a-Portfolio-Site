---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ConnectBanner from '../components/ConnectBanner.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects Portfolio | Javier Carrion (Javi)"
  description="Explore featured software engineering projects built by Javier Carrion, including SCRUMBLE, GDG Event Companion, and open-source tooling."
>
  <div class="container page-container">
    <header class="page-header">
      <div class="badge-gold">Portfolio</div>
      <h1 class="page-title">Engineering Projects</h1>
      <p class="page-lead">
        A selection of applications, interactive learning tools, and open-source demos built with clean code and modern web technologies.
      </p>
    </header>

    <div class="grid-3">
      {sortedProjects.map((project, index) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          coverImage={project.data.coverImage}
          tags={project.data.tags}
          demoUrl={project.data.demoUrl}
          demoLabel={project.data.demoLabel}
          repoUrl={project.data.repoUrl}
          repoLabel={project.data.repoLabel}
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
        />
      ))}
    </div>

    <ConnectBanner />
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-10);
    padding-bottom: var(--space-16);
  }

  .page-header {
    margin-bottom: var(--space-10);
    max-width: 800px;
  }

  .page-title {
    font-size: var(--fs-3xl);
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .page-lead {
    font-size: var(--fs-md);
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
